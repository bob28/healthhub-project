# Copy to .env for local development 
# Every value has a safe default in settings.py; override here per environment.

# --- Core ---------------------------------------------------------------
# Generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Omit for local SQLite. In production set a Postgres URL (e.g. Neon):
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

# --- CORS / CSRF (frontend origin) --------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# --- JWT auth cookies ---------------------------------------------------
# Local dev defaults (Lax + not-secure) work over HTTP on localhost.
# In production with the frontend on a DIFFERENT domain (Vercel) than the API,
# cookies are cross-site, so set:
#   JWT_COOKIE_SAMESITE=None
#   JWT_COOKIE_SECURE=True
# JWT_COOKIE_SAMESITE=Lax
# JWT_COOKIE_SECURE=False
# JWT_COOKIE_DOMAIN=